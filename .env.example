# ── Backend (app.py / FastAPI) ──
DATABASE_URL=postgresql://postgres:password@localhost:5432/sentiment
# If DATABASE_URL is unreachable, database.py falls back to local SQLite (sentiment.db)

API_KEY=your-secret-key-here
REQUIRE_API_KEY=false
LOG_LEVEL=INFO

NEWS_SOURCES=reuters,bloomberg,cnbc,marketwatch,yahoo,tradingview

FINBERT_MODEL_CACHE=/app/models
USE_GPU=true

# ── n8n integration (subscribe -> webhook handoff) ──
N8N_SUBSCRIBER_WEBHOOK_URL=https://your-n8n-instance/webhook/signal-subscriber
N8N_SUBSCRIBER_WEBHOOK_SECRET=replace-with-a-long-random-secret

# ── Frontend (Vite, set this in Vercel's project env vars) ──
# Point this at your local backend's public Cloudflare Tunnel URL, no trailing slash.
VITE_API_BASE_URL=http://localhost:8000
ADMIN_SECRET=oT-jaTfvlVjpYY_oqx4FMvNV4J74oP_B